{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "noEmit": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "*.config.*js",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts","**/*.mjs"
  ],
  "exclude": ["node_modules"]
}
